<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Jika request adalah file atau folder yang ada di direktori root, layani langsung
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Fallback: jika file uploads tidak ada di root, cari di public/uploads/
    RewriteCond %{REQUEST_URI} ^/[^/]+/uploads/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # 3. Jika request ke aset publik yang ada di folder public/ (assets, dll)
    RewriteCond %{DOCUMENT_ROOT}/eks_kargo_tracking_system_revisi/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 4. Dynamic MVC dispatch ke public/index.php
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]

</IfModule>
